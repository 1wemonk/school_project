    "file-loader": "^6.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "lodash": "^4.17.21",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "openai": "^4.90.0",
    "telegraf": "^4.16.3"
